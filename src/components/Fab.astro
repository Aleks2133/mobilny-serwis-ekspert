---
import { site } from '../data/site';
---

<div class="fixed bottom-6 right-6 z-40 hidden flex-col items-end gap-3 md:flex">
  <a
    href={`https://wa.me/${site.whatsapp}`}
    aria-label="Napisz na WhatsApp"
    class="flex h-12 w-12 items-center justify-center rounded-full border border-white/15 bg-asphalt-800/95 text-neutral-100 shadow-lg backdrop-blur transition hover:scale-105 hover:border-accent hover:text-accent"
  >
    <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"
      ><path
        d="M12 2a10 10 0 0 0-8.6 15l-1.4 5 5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1 1 12 20zm4.6-6c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1-.2.2-.6.8-.8 1-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.2 0-.4 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3c-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 1.6.7 2.2.8 3 .7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2 0-.1-.2-.2-.5-.3z"
      ></path></svg
    >
  </a>

  <a
    href={site.phoneHref}
    aria-label={`Zadzwoń: ${site.phone}`}
    class="group relative flex h-16 w-16 items-center justify-center rounded-full bg-accent text-ink shadow-[0_10px_30px_-8px_rgba(158,222,10,0.5)] transition hover:scale-105"
  >
    <span class="absolute inset-0 rounded-full bg-accent opacity-60 motion-safe:animate-ping"></span>
    <svg viewBox="0 0 24 24" class="relative h-6 w-6" fill="currentColor" aria-hidden="true"
      ><path
        d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1z"
      ></path></svg
    >
    <span
      class="pointer-events-none absolute right-full mr-3 whitespace-nowrap rounded-lg bg-black px-3 py-1.5 text-sm font-bold text-white opacity-0 shadow-lg transition-opacity group-hover:opacity-100"
    >
      {site.phone}
    </span>
  </a>
</div>
