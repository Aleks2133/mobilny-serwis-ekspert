---
import { faq } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
  heading?: string;
}
const { items = [...faq], heading = 'Najczęstsze pytania' } = Astro.props;
---

<section id="faq" class="border-t border-white/10 bg-black py-16 md:py-24">
  <div class="reveal-group mx-auto max-w-3xl px-4">
    <p class="mb-3 flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-accent"><span class="rule-slash"></span>FAQ</p>
    <h2 class="text-3xl font-extrabold text-white md:text-4xl">{heading}</h2>
    <div class="mt-8 divide-y divide-white/10 overflow-hidden rounded-2xl border border-white/10">
      {items.map((f) => (
        <details class="group">
          <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 font-semibold text-neutral-100 transition-colors hover:text-accent group-open:text-accent [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="shrink-0 text-xl leading-none text-accent transition-transform duration-300 group-open:rotate-45">+</span>
          </summary>
          <p class="px-5 pb-5 text-sm leading-relaxed text-neutral-400">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
