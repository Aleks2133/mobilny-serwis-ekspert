---
import { site, legal } from '../data/site';
import { cities, routes } from '../data/locations';
---

<footer class="border-t border-white/10 bg-black">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 md:grid-cols-4">
    <div class="md:col-span-2">
      <img src="/logo-white.png" alt={site.name} width="200" height="55" class="h-11 w-auto" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-neutral-400">
        Pomoc drogowa i mobilny mechanik. Baza w {site.base} — przy węźle Łask S8/S14.
        Działamy {site.hours} w promieniu ok. {site.rangeKm} km, w tym na S8, S14, A1 i A2.
      </p>
      <div class="mt-4 space-y-1 text-sm">
        <p><a href={site.phoneHref} class="font-bold text-accent">{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`} class="text-neutral-300 hover:text-accent">{site.email}</a></p>
        <p class="text-neutral-400">{site.address.street}, {site.address.postalCode} {site.address.locality}, woj. {site.address.region}</p>
      </div>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Miejscowości</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {cities.map((c) => (
          <li>
            <a href={`/${c.slug}`} class="text-neutral-400 hover:text-accent">Pomoc drogowa {c.name}</a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-bold uppercase tracking-[0.2em] text-accent">Trasy i baza</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {routes.map((r) => (
          <li><a href={`/${r.slug}`} class="text-neutral-400 hover:text-accent">{r.name}</a></li>
        ))}
        <li><a href="/serwis-stacjonarny-lask" class="text-neutral-400 hover:text-accent">Serwis stacjonarny Łask</a></li>
        <li><a href="/parking-tir-lask" class="text-neutral-400 hover:text-accent">Parking dla TIR-ów</a></li>
        <li><a href="/realizacje" class="text-neutral-400 hover:text-accent">Realizacje</a></li>
        <li><a href="/blog" class="text-neutral-400 hover:text-accent">Poradnik kierowcy</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 py-5">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 text-xs text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} {legal.entity} · NIP {legal.nip} · KRS {legal.krs}</p>
      <p><a href="/polityka-prywatnosci" class="hover:text-accent">Polityka prywatności</a></p>
    </div>
  </div>
</footer>
