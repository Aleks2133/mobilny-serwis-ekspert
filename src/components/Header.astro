---
import { site } from '../data/site';

const nav = [
  { href: '/#uslugi', label: 'Usługi' },
  { href: '/#obszar', label: 'Obszar' },
  { href: '/#realizacje', label: 'Realizacje' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#kontakt', label: 'Kontakt' },
];
---

<header class="sticky top-0 z-50">
  <!-- Górny pasek -->
  <div class="bg-black text-xs font-semibold uppercase tracking-wider text-neutral-500">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2">
      <p class="flex items-center gap-2 text-[13px] text-neutral-300">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
        </span>
        Dyżur <span class="text-accent">24/7</span>
      </p>
      <p class="hidden sm:block">Węzeł Łask · S8 / S14 · zasięg ~{site.rangeKm} km</p>
      <a href={`mailto:${site.email}`} class="hidden transition hover:text-accent md:block">{site.email}</a>
    </div>
  </div>

  <!-- Lewitująca pigułka -->
  <div class="px-3">
    <div
      id="navpill"
      class="navpill mx-auto mt-4 flex max-w-6xl items-center justify-between gap-4 rounded-2xl border border-white/10 bg-black px-4 py-3 md:px-6"
    >
      <a href="/" aria-label={`${site.name} — strona główna`}>
        <img src="/logo-white.png" alt={site.name} width="200" height="55" class="logo h-9 w-auto md:h-11" />
      </a>

      <nav class="hidden items-center gap-8 lg:flex" aria-label="Główna nawigacja">
        {nav.map((i) => (
          <a
            href={i.href}
            class="relative py-1 text-xs font-bold uppercase tracking-widest text-neutral-300 transition after:absolute after:-bottom-0.5 after:left-0 after:h-0.5 after:w-full after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-200 hover:text-white hover:after:scale-x-100"
          >
            {i.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={site.phoneHref}
          class="group relative inline-flex items-center gap-2 overflow-hidden rounded-xl bg-accent px-5 py-2.5 text-sm font-bold text-ink transition-transform duration-200 hover:scale-[1.03]"
        >
          <span class="absolute inset-0 -translate-x-full bg-white/30 transition-transform duration-500 group-hover:translate-x-full"></span>
          <svg viewBox="0 0 24 24" class="relative h-4 w-4" fill="currentColor" aria-hidden="true"
            ><path
              d="M6.6 10.8a15.5 15.5 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.7.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.7.1.4 0 .8-.3 1z"
            ></path></svg
          >
          <span class="relative hidden sm:inline">{site.phone}</span>
          <span class="relative sm:hidden">Zadzwoń</span>
        </a>

        <details class="group relative lg:hidden">
          <summary
            class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-lg border border-white/15 text-neutral-200 [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 group-open:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg viewBox="0 0 24 24" class="hidden h-5 w-5 group-open:block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </summary>
          <div class="absolute right-0 mt-3 w-56 rounded-xl border border-white/10 bg-asphalt-700 p-2 shadow-2xl">
            {nav.map((i) => (
              <a href={i.href} class="block rounded-lg px-3 py-2 text-xs font-bold uppercase tracking-widest text-neutral-300 hover:bg-white/5 hover:text-white">
                {i.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .navpill {
    animation: pill-in 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: top center;
    will-change: transform;
    box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.75);
    transition:
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.45s ease;
  }

  .navpill .logo {
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: left center;
  }

  /* stan po przewinięciu – pigułka „przyciąga się" i mocniej lewituje */
  .navpill.is-scrolled {
    transform: translateY(-0.45rem) scale(0.86);
    box-shadow: 0 22px 48px -14px rgba(0, 0, 0, 0.9);
  }
  .navpill.is-scrolled .logo {
    transform: scale(0.86);
  }

  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(-18px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navpill { animation: none; }
  }
</style>

<script is:inline>
  (function () {
    var pill = document.getElementById('navpill');
    if (!pill) return;
    var scrolled = false;
    function onScroll() {
      var y = window.scrollY || document.documentElement.scrollTop;
      if (!scrolled && y > 24) {
        scrolled = true;
        pill.classList.add('is-scrolled');
      } else if (scrolled && y < 8) {
        scrolled = false;
        pill.classList.remove('is-scrolled');
      }
    }
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
