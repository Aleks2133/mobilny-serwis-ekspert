---
import { site } from '../data/site';
import { fmtDate, type Post } from '../data/posts';

interface Props { post: Post; backHref: string; backLabel: string; }
const { post, backHref, backLabel } = Astro.props;
---

<article class="py-14 md:py-20">
  <div class="reveal-group mx-auto max-w-2xl px-4">
    <a href={backHref} class="text-sm text-accent hover:underline">← {backLabel}</a>
    <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-accent">
      {post.location ? `${post.location} · ` : ''}{fmtDate(post.date)}
    </p>
    <h1 class="mt-2 text-3xl font-extrabold text-white md:text-4xl">{post.title}</h1>
    <div class="mt-6 space-y-4 leading-relaxed text-neutral-300">
      {post.body.map((para) => <p>{para}</p>)}
    </div>

    <div class="mt-10 rounded-2xl border border-white/10 bg-black p-6 text-center">
      <p class="font-bold text-white">Masz podobny problem?</p>
      <a href={site.phoneHref} class="mt-3 inline-block rounded-full bg-accent px-6 py-3 font-bold text-ink transition hover:bg-accent-600">
        Zadzwoń: {site.phone}
      </a>
    </div>
  </div>
</article>
