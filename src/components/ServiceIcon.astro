  battery: 'M4 8h13v8H4zM17 11h3v2h-3M8 6v2M13 6v2M7.5 12h3M9 10.5v3',
  fuel: 'M5 20V6a2 2 0 0 1 2-2h5a2 2 0 0 1 2 2v14M4 20h11M14 9h2.5a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0V8l-2.5-2.5',
