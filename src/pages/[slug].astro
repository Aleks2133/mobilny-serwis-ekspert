---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { site, services, steps, faq } from '../data/site';
import { cities, routes } from '../data/locations';

export function getStaticPaths() {
  const cityPaths = cities.map((c) => ({ params: { slug: c.slug }, props: { kind: 'city', data: c } }));
  const routePaths = routes.map((r) => ({ params: { slug: r.slug }, props: { kind: 'route', data: r } }));
  return [...cityPaths, ...routePaths];
}

const { kind, data } = Astro.props as any;
const isCity = kind === 'city';

const title = isCity ? `Pomoc drogowa ${data.name}` : data.name;
const h1 = isCity ? `Pomoc drogowa ${data.name}` : data.name;
const where = isCity ? `w ${data.nameLoc} i okolicach` : `na trasie ${data.short}`;
const canonicalPath = `/${data.slug}`;

const description = isCity
  ? `Pomoc drogowa i mobilny mechanik ${data.name} — dojazd ok. ${data.driveMin} od węzła Łask (S8/S14). Holowanie, naprawa na miejscu, odpalanie auta, dowóz paliwa. Czynne 24/7.`
  : `Pomoc drogowa ${data.short} — awarie, kolizje, holowanie z pasa awaryjnego i MOP-ów. Baza przy węźle Łask, dyżur 24/7. Zadzwoń: ${site.phone}.`;

// Powiązane lokalizacje (linkowanie wewnętrzne)
const related = (isCity ? cities : routes).filter((x: any) => x.slug !== data.slug).slice(0, 5);
const relatedRoutes = routes.slice(0, 4);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Obszar działania', item: `${site.url}/#obszar` },
      { '@type': 'ListItem', position: 3, name: title, item: new URL(canonicalPath, site.url).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Pomoc drogowa i mobilny mechanik',
    name: `${title} — ${site.name}`,
    description,
    provider: {
      '@type': 'AutoRepair',
      name: site.name,
      telephone: site.phone,
      areaServed: isCity ? data.name : `trasa ${data.short}`,
    },
    areaServed: { '@type': 'Place', name: isCity ? data.name : `trasa ${data.short}` },
    availableChannel: {
      '@type': 'ServiceChannel',
      servicePhone: site.phone,
      availableLanguage: 'pl',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout title={title} description={description} path={canonicalPath} jsonLd={jsonLd}>
  <section class="border-b border-white/10 py-14 md:py-20">
    <div class="reveal-group mx-auto max-w-4xl px-4">
      <nav class="text-xs text-neutral-500" aria-label="Ścieżka nawigacji">
        <a href="/" class="hover:text-accent">Strona główna</a> /
        <a href="/#obszar" class="hover:text-accent">Obszar działania</a> /
        <span class="text-neutral-300">{title}</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white md:text-4xl">
        {h1} <span class="text-accent">— 24/7</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">{data.intro}</p>
      {isCity && (
        <p class="mt-3 text-sm text-neutral-500">
          Odległość od bazy w Orchowie: ok. {data.distanceKm} km · orientacyjny czas dojazdu: {data.driveMin}
        </p>
      )}
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={site.phoneHref} class="rounded-full bg-accent px-6 py-3 font-bold text-ink transition hover:bg-accent-600">
          Zadzwoń: {site.phone}
        </a>
        <a href={`https://wa.me/${site.whatsapp}`} class="rounded-full border border-white/25 px-6 py-3 font-semibold text-neutral-100 transition hover:border-accent hover:text-accent">
          WhatsApp / SMS
        </a>
      </div>
    </div>
  </section>

  {data.body && (
    <section class="border-t border-white/10 py-14 md:py-20">
      <div class="reveal-group mx-auto max-w-3xl px-4">
        <h2 class="text-2xl font-extrabold text-white md:text-3xl">
          {isCity ? `Pomoc drogowa ${data.nameLoc} — jak działamy` : `${data.name} — jak działamy`}
        </h2>
        <div class="mt-5 space-y-4 leading-relaxed text-neutral-300">
          {data.body.map((para: string) => <p>{para}</p>)}
        </div>
      </div>
    </section>
  )}

  <section class="border-t border-white/10 py-14 md:py-20">
    <div class="reveal-group mx-auto max-w-4xl px-4">
      <h2 class="text-2xl font-extrabold text-white md:text-3xl">Zakres pomocy {where}</h2>
      <div class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2">
        {services.map((s) => (
          <div class="group bg-ink p-6 transition-colors duration-300 hover:bg-[#11150a]">
            <h3 class="font-bold text-white transition-colors group-hover:text-accent">{s.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-neutral-400">{s.desc}</p>
          </div>
        ))}
      </div>

      <h2 class="mt-14 text-2xl font-extrabold text-white md:text-3xl">
        {isCity ? 'Charakterystyczne punkty' : 'Węzły i MOP-y na trasie'}
      </h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {(isCity ? data.landmarks : data.points).map((p: string) => (
          <li class="rounded-full border border-accent/30 px-3 py-1 text-sm text-neutral-300">{p}</li>
        ))}
      </ul>

      <h2 class="mt-14 text-2xl font-extrabold text-white md:text-3xl">Jak wygląda zgłoszenie</h2>
      <ol class="mt-5 space-y-4">
        {steps.map((st) => (
          <li class="flex gap-4">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-sm font-extrabold text-black">{st.n}</span>
            <span class="pt-1"><strong class="text-white">{st.title}.</strong> <span class="text-neutral-400">{st.desc}</span></span>
          </li>
        ))}
      </ol>

      <div class="mt-14 rounded-2xl border border-white/10 bg-black p-6">
        <h2 class="text-lg font-bold text-white">Serwis stacjonarny i parking dla TIR-ów</h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-400">
          Jeśli naprawa wymaga warunków warsztatowych, holujemy auto do naszego serwisu w{' '}
          <a href="/serwis-stacjonarny-lask" class="text-accent hover:underline">Orchowie 177 pod Łaskiem</a>. Dla
          ciężarówek mamy{' '}
          <a href="/parking-tir-lask" class="text-accent hover:underline">strzeżony parking</a>{' '}
          z pełnym zapleczem: toaleta i prysznic dla kierowców.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 py-14 md:py-20">
    <div class="reveal-group mx-auto max-w-4xl px-4">
      <h2 class="text-2xl font-extrabold text-white md:text-3xl">Obsługujemy też w pobliżu</h2>
      <div class="mt-6 flex flex-wrap gap-2">
        {related.map((x: any) => (
          <a href={`/${x.slug}`} class="rounded-full border border-white/15 px-4 py-2 text-sm text-neutral-300 transition hover:border-accent hover:text-accent">
            {x.name}
          </a>
        ))}
        {isCity && relatedRoutes.map((r: any) => (
          <a href={`/${r.slug}`} class="rounded-full border border-white/15 px-4 py-2 text-sm text-neutral-300 transition hover:border-accent hover:text-accent">
            {r.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq items={[...faq]} heading={`Pytania — ${title}`} />
</Layout>
