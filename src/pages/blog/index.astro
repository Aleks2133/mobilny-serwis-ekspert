---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { posts, fmtDate } from '../../data/posts';

const items = posts.filter((p) => p.type === 'poradnik');
---

<Layout
  title="Poradnik kierowcy"
  description={`Co robić przy awarii na S8/S14, ile kosztuje holowanie, OC sprawcy — praktyczne porady. ${site.name}.`}
  path="/blog"
>
  <section class="border-b border-white/10 py-14 md:py-20">
    <div class="mx-auto max-w-4xl px-4">
      <div class="rule-slash mb-4"></div>
      <h1 class="text-3xl font-extrabold text-white md:text-4xl">Poradnik kierowcy</h1>
      <p class="mt-4 max-w-2xl text-neutral-300">
        Konkretne odpowiedzi na pytania, które kierowcy wpisują w Google zanim (albo zaraz po tym, jak) coś się zepsuje.
      </p>
    </div>
  </section>
  <section class="py-14">
    <div class="reveal-group mx-auto grid max-w-4xl gap-4 px-4">
      {items.map((p) => (
        <a href={`/blog/${p.slug}`} class="group relative overflow-hidden rounded-2xl border border-white/10 p-6 transition-colors duration-300 hover:border-accent/50 hover:bg-[#11150a]">
          <span class="absolute inset-y-0 left-0 w-[3px] origin-top scale-y-0 bg-accent transition-transform duration-300 group-hover:scale-y-100"></span>
          <p class="text-xs font-bold uppercase tracking-wider text-accent">{fmtDate(p.date)}</p>
          <h2 class="mt-2 text-xl font-bold text-white transition-colors group-hover:text-accent">{p.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-neutral-400">{p.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
