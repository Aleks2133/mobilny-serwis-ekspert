---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import { site, facility, faq } from '../data/site';
import AmenityIcon from '../components/AmenityIcon.astro';

const p = facility.parking;
const path = '/parking-tir-lask';
const description =
  'Strzeżony, oświetlony i monitorowany parking dla TIR-ów w Orchowie 177 przy węźle Łask (S8/S14). Miejsca dla ciężarówek i zestawów, toalety i prysznic. Całodobowo.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Parking dla TIR-ów', item: new URL(path, site.url).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ParkingFacility',
    name: p.name,
    url: new URL(path, site.url).href,
    telephone: site.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: site.address.street,
      addressLocality: site.address.locality,
      postalCode: site.address.postalCode,
      addressRegion: site.address.region,
      addressCountry: 'PL',
    },
    geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
    openingHours: 'Mo-Su 00:00-23:59',
    amenityFeature: p.amenities.map((a) => ({
      '@type': 'LocationFeatureSpecification',
      name: a.label,
      value: true,
    })),
  },
];
---

<Layout title="Parking dla TIR-ów — Łask / Orchów" description={description} path={path} jsonLd={jsonLd}>
  <section class="border-b border-white/10 py-14 md:py-20">
    <div class="reveal-group mx-auto max-w-4xl px-4">
      <nav class="text-xs text-neutral-500" aria-label="Ścieżka nawigacji">
        <a href="/" class="hover:text-accent">Strona główna</a> / <span class="text-neutral-300">Parking dla TIR-ów</span>
      </nav>
      <h1 class="mt-4 text-3xl font-extrabold text-white md:text-4xl">
        Strzeżony parking dla TIR-ów <span class="text-accent">— Orchów, węzeł Łask</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-neutral-300">{p.desc}</p>
      <p class="mt-3 text-sm text-neutral-500">{p.address} · przy węźle Łask (S8 / S14) · czynny całodobowo</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href={site.phoneHref} class="rounded-full bg-accent px-6 py-3 font-bold text-ink transition hover:bg-accent-600">
          Rezerwacja miejsca: {site.phone}
        </a>
        <a
          href={facility.stationary.mapUrl}
          class="rounded-full border border-white/25 px-6 py-3 font-semibold text-neutral-100 transition hover:border-accent hover:text-accent"
        >
          Pokaż na mapie
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-white/10 py-14 md:py-20">
    <div class="reveal-group mx-auto max-w-4xl px-4">
      <h2 class="text-2xl font-extrabold text-white md:text-3xl">Co znajdziesz na miejscu</h2>
      <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {p.amenities.map((a) => (
          <li class="flex items-center gap-3 bg-ink p-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-accent/40 text-accent">
              <AmenityIcon name={a.icon} class="h-5 w-5" />
            </span>
            <span class="font-semibold text-neutral-100">{a.label}</span>
          </li>
        ))}
      </ul>

      <h2 class="mt-14 text-2xl font-extrabold text-white md:text-3xl">Dla kogo</h2>
      <div class="mt-5 space-y-4 leading-relaxed text-neutral-300">
        <p>
          Parking powstał z myślą o kierowcach zawodowych i firmach transportowych korzystających z S8, S14, A1 i A2.
          To bezpieczne miejsce postoju w trasie, na pauzę lub na czas oczekiwania na naprawę czy odbiór pojazdu.
        </p>
        <p>
          Zostawiasz u nas pojazd po awarii na trasie? Holujemy go prosto na plac, a Ty korzystasz z toalety
          i prysznica, zanim ruszysz dalej. Auta osobowe i dostawcze również mile widziane.
        </p>
        <p>
          Lokalizacja tuż przy węźle Łask oznacza zjazd z ekspresówki w kilkadziesiąt sekund — bez krążenia
          po mieście z naczepą.
        </p>
      </div>

      <div class="mt-14 rounded-2xl border border-white/10 bg-black p-6">
        <h2 class="text-lg font-bold text-white">Potrzebujesz też pomocy drogowej?</h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-400">
          Obsługujemy awarie i holowanie na{' '}
          <a href="/pomoc-drogowa-s8" class="text-accent hover:underline">S8</a>,{' '}
          <a href="/pomoc-drogowa-s14" class="text-accent hover:underline">S14</a>,{' '}
          <a href="/pomoc-drogowa-a1" class="text-accent hover:underline">A1</a> i{' '}
          <a href="/pomoc-drogowa-a2" class="text-accent hover:underline">A2</a> — 24/7.
        </p>
      </div>
    </div>
  </section>

  <Faq items={[...faq]} heading="Pytania — parking i baza" />
</Layout>
